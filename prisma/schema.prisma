// Fokus — indie oyun pazaryeri (Neon PostgreSQL)
// Kullanıcılar Clerk üzerinden senkronize edilir (application layer).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELED
}

enum PurchaseProvider {
  IYZICO
  /** Eski kayıtlar (artık yeni ödeme yok). */
  STRIPE
  MANUAL
  OTHER
}

enum EarningStatus {
  PENDING
  AVAILABLE
  PAID_OUT
  REVERSED
}

enum EarningSource {
  GAME_SALE
  REFUND_ADJUSTMENT
  PLATFORM_ADJUSTMENT
}

enum UserRole {
  USER
  DEVELOPER
  ADMIN
}

enum GameStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
}

enum ActivityType {
  PURCHASE
  WISHLIST_ADD
  CART_ADD
  REVIEW
}

enum ReleaseChannel {
  STABLE
  BETA
  ALPHA
}

enum ModerationStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum DownloadStatus {
  QUEUED
  DOWNLOADING
  PAUSED
  COMPLETED
  CANCELED
}

enum NewsKind {
  PATCH_NOTE
  EVENT
  NEWS
}

enum NotificationType {
  INFO
  SALE
  SYSTEM
}

enum WalletTxnType {
  TOPUP
  PURCHASE
  MARKET_BUY
  MARKET_SELL
}

enum GiftStatus {
  PENDING
  CLAIMED
  CANCELED
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String?
  username  String?
  imageUrl  String?
  passwordHash String?
  role      UserRole @default(USER)
  profileFrame String?
  profileBackground String?
  language String? @default("tr")
  storePreferences Json?
  notificationSettings Json?
  walletBalanceCents Int @default(0)
  /** Çevrimiçi göstergesi için son aktivite (presence ping). */
  lastSeenAt DateTime?
  /** Arkadaşlar ve liste için “çevrim dışı görün” (Steam gizli mod). */
  appearOffline Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]
  reviews   Review[]
  wishlists Wishlist[]
  cartItems CartItem[]
  earnings  Earning[]
  activities ActivityEvent[]
  sentFriendRequests Friend[] @relation("FriendSender")
  receivedFriendRequests Friend[] @relation("FriendReceiver")
  downloads DownloadItem[]
  newsPosts NewsPost[] @relation("NewsAuthor")
  walletTransactions WalletTransaction[]
  notifications Notification[]
  inventoryItems InventoryItem[]
  marketListings MarketListing[] @relation("SellerListings")
  reviewReports ReviewReport[]
  reviewHelpfulVotes ReviewHelpfulVote[]
  blocksInitiated UserBlock[] @relation("UserBlocksInitiated")
  blocksReceived UserBlock[] @relation("UserBlocksReceived")
  cloudSaves CloudSaveMetadata[]
  userAchievements UserAchievement[]
  payoutRequests PayoutRequest[]
  developerProfile DeveloperProfile?
  pendingCheckouts PendingCheckout[]
  iyzicoPaymentIntents IyzicoPaymentIntent[]
  friendMessagesSent     FriendMessage[] @relation("FriendMsgOut")
  friendMessagesReceived FriendMessage[] @relation("FriendMsgIn")
  giftsSent      Gift[] @relation("GiftSender")
  giftsReceived  Gift[] @relation("GiftRecipient")

  @@index([clerkId])
}

model FriendMessage {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  body       String
  createdAt  DateTime @default(now())

  sender   User @relation("FriendMsgOut", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("FriendMsgIn", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([receiverId, createdAt])
  @@index([senderId, receiverId])
}

/** Kart ödemesi (İyzico) için sepet anlık görüntüsü; callback ile tamamlanır. */
model PendingCheckout {
  id              String   @id @default(cuid())
  userId          String
  lines           Json
  couponCode      String?
  discountCents   Int      @default(0)
  chargedCents    Int
  currency        String   @default("try")
  /** Eski Stripe oturumları. */
  stripeSessionId String?  @unique
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  iyzicoIntent IyzicoPaymentIntent?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/** İyzico ödeme oturumu (sepet veya cüzdan yükleme). */
model IyzicoPaymentIntent {
  id                String   @id @default(cuid())
  /** İyzico `conversationId` (sepette PendingCheckout.id). */
  conversationId    String   @unique
  userId            String
  kind              String
  amountCents       Int
  currency          String   @default("TRY")
  pendingCheckoutId String?  @unique
  createdAt         DateTime @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  pendingCheckout PendingCheckout? @relation(fields: [pendingCheckoutId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

/** İyzico callback idempotency (`paymentId`). */
model IyzicoProcessedPayment {
  paymentId   String   @id
  processedAt DateTime @default(now())
}

model Game {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?

  coverImageUrl      String?
  screenshotUrls     String[] @default([])
  developerName      String
  /** Satıcı / geliştirici: uygulama katmanında `User.id` ile doldurulur (API: developer/games). */
  developerSlug      String?
  shortDescription   String?
  descriptionMd      String?

  priceCents          Int      @default(0)
  originalPriceCents  Int?
  currency            String   @default("TRY")
  isTurkishMade       Boolean  @default(false)

  platforms          Json?
  systemRequirements Json?

  isPublished Boolean  @default(false)
  status      GameStatus @default(DRAFT)
  viewCount   Int      @default(0)
  releasedAt  DateTime?
  releaseChannel   ReleaseChannel @default(STABLE)
  scheduledReleaseAt DateTime?

  /** Ana oyuna bağlı DLC / eklenti listesi (opsiyonel). */
  parentGameId String?
  parentGame   Game?    @relation("GameDlcTree", fields: [parentGameId], references: [id], onDelete: SetNull)
  dlcs         Game[]   @relation("GameDlcTree")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories GameCategory[]
  purchases  Purchase[]
  reviews    Review[]
  wishlists  Wishlist[]
  cartItems  CartItem[]
  earnings   Earning[]
  activities ActivityEvent[]
  newsPosts  NewsPost[]
  downloads  DownloadItem[]
  inventoryItems InventoryItem[]
  achievements Achievement[]
  cloudSaves CloudSaveMetadata[]
  gifts      Gift[]

  @@index([isPublished, createdAt])
  @@index([developerSlug])
  @@index([releaseChannel])
  @@index([parentGameId])
}

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  games GameCategory[]
}

model GameCategory {
  gameId     String
  categoryId String

  game       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@id([gameId, categoryId])
  @@index([categoryId])
}

model Purchase {
  id          String           @id @default(cuid())

  userId      String
  gameId      String

  amountCents Int
  currency    String           @default("TRY")
  status      PurchaseStatus   @default(PENDING)
  provider    PurchaseProvider @default(OTHER)

  providerRef String?
  /** Stripe PaymentIntent (kısmi iade ve gerçek ödeme iadesi için). */
  stripePaymentIntentId   String?
  /** Aynı Checkout oturumundan gelen satırları gruplamak için. */
  stripeCheckoutSessionId String?
  /** İyzico ödeme kimliği (retrieve sonucu). */
  iyzicoPaymentId         String?

  paidAt      DateTime?

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game    Game     @relation(fields: [gameId], references: [id], onDelete: Restrict)
  earning Earning?

  @@index([userId, createdAt])
  @@index([gameId, createdAt])
  @@index([status, createdAt])
  @@index([stripeCheckoutSessionId])
  @@index([iyzicoPaymentId])
  @@unique([userId, gameId, providerRef])
}

model Review {
  id        String   @id @default(cuid())

  userId    String
  gameId    String

  rating    Int
  title     String?
  content   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId, createdAt])
  @@index([rating])
  reports      ReviewReport[]
  helpfulVotes ReviewHelpfulVote[]
}

model ReviewReport {
  id         String            @id @default(cuid())
  reviewId   String
  reporterId String
  reason     String
  status     ModerationStatus  @default(PENDING)
  createdAt  DateTime          @default(now())
  resolvedAt DateTime?

  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter User   @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([reviewId])
}

model ReviewHelpfulVote {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  helpful   Boolean
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId])
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("UserBlocksInitiated", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("UserBlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Achievement {
  id          String   @id @default(cuid())
  gameId      String
  slug        String
  title       String
  description String?
  createdAt   DateTime @default(now())

  game     Game              @relation(fields: [gameId], references: [id], onDelete: Cascade)
  progress UserAchievement[]

  @@unique([gameId, slug])
  @@index([gameId])
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

model CloudSaveMetadata {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  slot      String   @default("0")
  sizeBytes Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId, slot])
  @@index([userId, updatedAt])
}

model DeveloperProfile {
  userId         String   @id
  kycStatus      String   @default("UNVERIFIED")
  onboardingStep Int      @default(0)
  taxId          String?
  buildScanNote  String?
  /** Stripe Connect Express hesabı (geliştirici ödemeleri). */
  stripeConnectAccountId   String? @unique
  stripeChargesEnabled     Boolean @default(false)
  stripePayoutsEnabled     Boolean @default(false)
  stripeDetailsSubmitted   Boolean @default(false)
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PayoutRequest {
  id           String    @id @default(cuid())
  developerId  String
  amountCents  Int
  status       String    @default("PENDING")
  note         String?
  createdAt    DateTime  @default(now())
  paidAt       DateTime?

  developer User @relation(fields: [developerId], references: [id], onDelete: Cascade)

  @@index([developerId, createdAt])
  @@index([status])
}

model Wishlist {
  id        String   @id @default(cuid())

  userId    String
  gameId    String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([userId, createdAt])
}

model Earning {
  id               String        @id @default(cuid())

  userId           String
  gameId           String
  purchaseId       String?       @unique

  grossCents       Int
  platformFeeCents Int           @default(0)
  netCents         Int
  currency         String        @default("TRY")
  status           EarningStatus @default(PENDING)
  source           EarningSource @default(GAME_SALE)
  /** Stripe Connect: geliştiriciye yapılan transfer (STRIPE_CONNECT_ENABLED=1). */
  stripeTransferId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  game     Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  purchase Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([gameId, createdAt])
  @@index([status])
  @@index([stripeTransferId])
}

model ActivityEvent {
  id        String       @id @default(cuid())
  userId    String
  gameId    String?
  type      ActivityType
  message   String
  createdAt DateTime     @default(now())

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game?        @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model Friend {
  id          String   @id @default(cuid())
  senderId    String
  receiverId  String
  acceptedAt  DateTime?
  createdAt   DateTime @default(now())

  sender      User @relation("FriendSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User @relation("FriendReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, createdAt])
}

model NewsPost {
  id          String   @id @default(cuid())
  authorId    String
  gameId      String?
  title       String
  body        String
  kind        NewsKind @default(NEWS)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author      User @relation("NewsAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  game        Game? @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@index([publishedAt])
  @@index([kind, publishedAt])
}

model DownloadItem {
  id          String   @id @default(cuid())
  userId      String
  gameId      String
  channel     ReleaseChannel @default(STABLE)
  status      DownloadStatus @default(QUEUED)
  progress    Int      @default(0)
  speedMbps   Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game        Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([userId, createdAt])
  @@index([channel])
}

model WalletTransaction {
  id          String   @id @default(cuid())
  userId      String
  amountCents Int
  type        WalletTxnType
  description String
  createdAt   DateTime @default(now())

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        NotificationType @default(INFO)
  title       String
  readAt      DateTime?
  createdAt   DateTime @default(now())

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model InventoryItem {
  id          String   @id @default(cuid())
  userId      String
  gameId      String?
  name        String
  imageUrl    String?
  createdAt   DateTime @default(now())

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game        Game? @relation(fields: [gameId], references: [id], onDelete: SetNull)
  listing     MarketListing?

  @@index([userId, createdAt])
}

model MarketListing {
  id            String   @id @default(cuid())
  sellerId      String
  inventoryItemId String @unique
  priceCents    Int
  soldAt        DateTime?
  createdAt     DateTime @default(now())

  seller        User @relation("SellerListings", fields: [sellerId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([soldAt, createdAt])
}

model Gift {
  id             String     @id @default(cuid())
  claimToken     String     @unique @default(cuid())
  senderId       String
  recipientId    String?
  recipientEmail String
  gameId         String
  amountCents    Int
  currency       String     @default("TRY")
  status         GiftStatus @default(PENDING)
  note           String?
  claimedAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  sender         User       @relation("GiftSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient      User?      @relation("GiftRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  game           Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([senderId, createdAt])
  @@index([recipientEmail, status, createdAt])
  @@index([recipientId, createdAt])
}
