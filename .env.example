# =============================================================================
# Fokus — örnek ortam değişkenleri (kopyala: .env.local)
# =============================================================================

# --- Neon PostgreSQL ---
# Geçerli kullanıcı/şifre/host ile doldur; hatalı URL "Authentication failed" verir.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- Clerk (auth) ---
# https://dashboard.clerk.com — canlıda “Production” anahtarları (pk_live_ / sk_live_)
# ÖNEMLİ: İkisini birden tanımlayın. Sadece publishable key bırakmayın; uygulama demo girişe düşer
# ama arayüz karışır. Clerk kullanmayacaksanız bu iki satırı tamamen kaldırın veya boş bırakın.
#
# Vercel canlı URL’sini Clerk’e ekle: Dashboard → Configure → Domains (örn. https://proje.vercel.app)
# Paths → Allowed redirect / callback URL’lere aynı kök + /sign-in, /sign-up, /sso-callback ekle.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Demo e-posta/şifre oturumu (Clerk yokken). Üretimde (doğrulama açıkken) en az 32 karakter zorunludur.
# DEMO_AUTH_SECRET="<openssl rand -hex 32 çıktısı>"

# --- Uygulama URL (metadata, İyzico callback, sitemap) ---
# Canlı: https://senin-domainin.com veya https://xxx.vercel.app
# (İyzico callback: {NEXT_PUBLIC_APP_URL}/api/payments/iyzico/callback)
# Vercel’de boş bırakırsan otomatik VERCEL_URL (https) kullanılır; özel alan adı için burayı doldur.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Kendi sunucunda (Docker vb.) üretim doğrulamasını zorla:
# FOKUS_ENFORCE_PRODUCTION_ENV=1
# Vercel Production’da VERCEL_ENV=production ile otomatik doğrulama çalışır.
# Geçici olarak kapat: SKIP_PRODUCTION_ENV_VALIDATION=1

# --- İyzico (kart ödemesi — Türkiye / sandbox) ---
# https://merchant.iyzipay.com → Ayarlar → API Anahtarları (sandbox anahtarları ayrı)
IYZICO_API_KEY="sandbox-xxxxxxxx"
IYZICO_SECRET_KEY="sandbox-yyyyyyyy"
# Sandbox varsayılanı; canlı: https://api.iyzipay.com
IYZICO_URI="https://sandbox-api.iyzipay.com"

# iyzipay npm paketi alternatif isimleri (isteğe bağlı):
# IYZIPAY_API_KEY=...
# IYZIPAY_SECRET_KEY=...
# IYZIPAY_URI=https://sandbox-api.iyzipay.com

# Ödeme kanalı: anahtarlar varsa otomatik kart (iyzico), wallet = yalnız cüzdan, iyzico = kart zorunlu (anahtar gerekir)
NEXT_PUBLIC_CHECKOUT_PROVIDER="wallet"
# Cüzdanı zorla (İyzico olsa bile): FORCE_WALLET_CHECKOUT=1

# Callback (İyzico ödeme formu sonrası): POST {NEXT_PUBLIC_APP_URL}/api/payments/iyzico/callback
# Panelde “callback URL” olarak tam bu adresi kaydet (canlıda https).

# Üretimde kart ödemesini zorunlu kıl: FOKUS_REQUIRE_CARD_CHECKOUT=1 (IYZICO_* gerekir)

# --- Resend (satın alma e-postası, isteğe bağlı) ---
# https://resend.com — alan adını doğrula, gönderen adresi onaylı olmalı
# RESEND_API_KEY="re_..."
# RESEND_FROM="Fokus <siparis@alanadin.com>"

# --- Platform payı (basis points, 1500 = %15) ---
PLATFORM_FEE_BPS="1500"

# --- Upstash Redis (middleware rate limit; yoksa limit devre dışı) ---
# https://console.upstash.com
UPSTASH_REDIS_REST_URL="https://YOUR-REDIS-XXXX.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR_TOKEN"

# --- Uploadthing (dosya yükleme) ---
UPLOADTHING_SECRET="sk_live_..."
UPLOADTHING_APP_ID="..."
UPLOADTHING_TOKEN="..."

# --- Gözlemlenebilirlik (isteğe bağlı) ---
# SENTRY_DSN="https://...@.ingest.sentry.io/..."
# NEXT_PUBLIC_SENTRY_DSN="..."

# --- Mevsim kampanyası ---
FEATURE_SEASONAL_SALE="false"
SEASONAL_SALE_LABEL="Fokus yıl ortası — seçili oyunlarda indirim"

# --- Seed geliştirici (Clerk yokken yerel giriş) ---
# prisma db seed sonrası dev@fokus.example ile giriş için (en az 8 karakter):
# SEED_DEV_PASSWORD="guclu-bir-sifre-buraya"

# Demo: Clerk metadata yokken "herkes geliştirici" — yalnızca yerel geliştirme. Canlıda true yapma.
# DEMO_MODE="false"

# NODE_ENV=production iken ücretsiz cüzdan yükleme kapalıdır. Staging’de (dikkatli) açmak için:
# FOKUS_ALLOW_DEMO_WALLET_TOPUP="1"

# Destek e-postası (isteğe bağlı — /support sayfasında gösterilir)
# NEXT_PUBLIC_SUPPORT_EMAIL="destek@alanadin.com"

# --- İlk kurulum ---
# npx prisma db push
# npx prisma db seed
